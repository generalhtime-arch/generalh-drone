# CORESERVER (Apache) 用: 存在しないURLに独自404ページを返します。
# ErrorDocument の内部処理では元の HTTP 404 ステータスが維持されます。
ErrorDocument 404 /404.html

# ディレクトリ内のファイル一覧を表示しません。
Options -Indexes

# Gitの内部情報、運用用の文書・スクリプト、設定ファイルは公開しません。
# 公開フォルダーにリポジトリ全体を配置する場合にも適用されます。
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(?:git|hg|svn)(?:/|$) - [F,L,NC]
  RewriteRule ^(?:README|SECURITY)(?:\.md)?$ - [F,L,NC]
  RewriteRule (^|/)(?:tools|\.codex-remote-attachments)(?:/|$) - [F,L,NC]
  # 運用中に残したバックアップは削除せず、Webからは参照できないようにします。
  RewriteRule (^|/).*(?:[._-](?:backup|bak|old|orig))\.[^/]+$ - [F,L,NC]
  RewriteRule \.(?:bak|conf|dist|env|ini|log|md|ps1|sh|sql|swp|ya?ml)$ - [F,L,NC]

  # この公開サイトは読み取り専用です。予約フォームを自サイトで実装するまでは、
  # GET と HEAD 以外のHTTPメソッドを受け付けません。
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$ [NC]
  RewriteRule ^ - [F,L]
</IfModule>

# この静的サイトでは外部のスクリプト、フォント、iframe、フォーム送信を使用しません。
# 将来、予約フォームを埋め込む／外部へ送信する場合は、該当の送信先だけを
# form-action、frame-src、connect-src へ明示的に追加してください。
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; child-src 'none'; worker-src 'none'; object-src 'none'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; media-src 'self'; manifest-src 'self'; upgrade-insecure-requests; block-all-mixed-content"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Origin-Agent-Cluster "?1"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By
  Header always unset X-Turbo-Charged-By
</IfModule>
